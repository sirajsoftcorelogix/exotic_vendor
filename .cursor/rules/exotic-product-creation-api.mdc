            "https://domain.com/images/saris/zzz991-yellow.jpg",
            "https://domain.com/images/saris/zzz991-black.jpg",
            "https://domain.com/images/saris/zzz991-black_a01.jpg",
            "https://domain.com/images/saris/zzz991-black_a02.jpg"
        ]
    }
}
```
