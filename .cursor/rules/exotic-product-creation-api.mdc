    "itemcode": "ZZZ991",
    "groupname": "textiles",
    "category": "1162",
    "itemtype": "product",
    "title": "Trial new product",
    "status": 1,
    "optionals": "OPTIONALS_TEXTILES_SARIS",
    "material": "silk",
    "item_stock_price": [
        {
            "size": "",
            "color": "yellow",
            "item_level": "variation",
            "date_added": "2025-12-02",
            "stock_date_added": "2025-12-02",
            "local_stock": 5,
            "price": 40,
            "price_india": 800,
            "gst": 12
        },
        {
            "size": "",
            "color": "black",
            "item_level": "variation",
            "date_added": "2025-12-02",
            "stock_date_added": "2025-12-02",
            "local_stock": 5,
            "price": 40,
            "price_india": 800,
            "gst": 12
        }
    ],
    "images": {
        "image_directory": "",
